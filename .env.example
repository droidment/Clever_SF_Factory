# Local demonstration. Never expose demo authentication to a network.
FACTORY_MODE=demo
FACTORY_DATABASE_URL=sqlite:///./data/factory.db
# inprocess: requests live in the API process. postgres: durable, needs a PostgreSQL URL.
FACTORY_RUNTIME=inprocess
# False when `python -m factory.worker` processes run the requests instead of the API.
FACTORY_DISPATCH_ENABLED=true
# Local real-model drafts: use scripts/start-anthropic.ps1 for a masked key prompt.
# ANTHROPIC_API_KEY is also accepted from the process environment. Never commit a key.
FACTORY_ANTHROPIC_MODEL=claude-sonnet-5
FACTORY_ANTHROPIC_MAX_TOKENS=4096
# Production: set MODE=gateway, RUNTIME=postgres and AUTH_MODE=oidc. A trusted gateway is required.
FACTORY_AUTH_MODE=demo
FACTORY_OIDC_ISSUER=
FACTORY_OIDC_AUDIENCE=software-factory
FACTORY_OIDC_JWKS_URL=
FACTORY_GATEWAY_URL=
FACTORY_GATEWAY_TOKEN=
# Comma separated exact repository identifiers, not arbitrary clone URLs.
FACTORY_ALLOWED_REPOSITORIES=platform/customer-portal,platform/order-service,platform/shared-libraries

# Execution gateway (`python -m gateway`). See docs/gateway.md. GATEWAY_TOKEN equals FACTORY_GATEWAY_TOKEN.
GATEWAY_TOKEN=
GATEWAY_MODEL=claude-opus-5-5
# docker: no network, throwaway container. process: runs on this host; trusted repositories only.
GATEWAY_SANDBOX=docker
GATEWAY_REPOSITORIES_FILE=gateway.repositories.json
GATEWAY_GITHUB_TOKEN=
